# Modo multi-tenant (default) — lee tenants desde pb_ws
PB_WS_URL=http://localhost:8190
PB_WS_ADMIN_EMAIL=
PB_WS_ADMIN_PASSWORD=
# Path al data.db de cada tenant cuando workspaces no tiene pb_data_path
# PB_DATA_TEMPLATE=/root/sites/traksync.io/pb-workspaces/{tenant}/pb_data/data.db

# Comunes
LAKE_DIR=/data/lake
# SNAPSHOT_DATE=2026-08-01   # override para backfill
# Módulo EVM compartido con los hooks de approcket (default: repo vecino)
# EVM_LIB_PATH=/root/sites/rocket.telemaco.ar/app/rocket/pocketbase/pb_hooks/lib/evm.js

# Modo single-tenant manual (dev/test) — si se setean ambas, se salta pb_ws
# PB_DATA=../pb/pb_tsp/pb_data/data.db
# TENANT_ID=tsp

# Solo para bin/validate.mjs (siempre single-tenant)
# PB_URL=http://localhost:8090
# PB_ADMIN_EMAIL=
# PB_ADMIN_PASSWORD=
# VALIDATE_PROJECT_CODE=WHCP2029
